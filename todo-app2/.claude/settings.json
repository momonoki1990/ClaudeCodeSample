{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read",
      "Bash(cargo *)",
      "Bash(git checkout -b feature/*)",
      "Bash(git switch feature/*)",
      "Bash(git switch -c feature/*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git remote -v)",
      "Bash(git remote get-url*)",
      "Bash(git remote show*)",
      "Bash(git fetch*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git ls-tree*)",
      "Bash(git rev-parse*)",
      "Bash(git push origin feature/*)",
      "Bash(git push -u origin feature/*)",
      "Bash(git switch develop)",
      "Bash(git checkout develop)",
      "Bash(git pull*)",
      "Bash(git merge origin/develop*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr status*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr merge *)",
      "Bash(ssh-add -l)",
      "Bash(ls*)",
      "Bash(jq *)",
      "Bash(sleep*)",
      "Bash(wait*)",
      "Bash(kill*)",
      "Bash(curl http://127.0.0.1*)",
      "Bash(curl http://localhost*)",
      "Bash(curl -s http://127.0.0.1*)",
      "Bash(curl -s http://localhost*)",
      "Bash(curl -sS http://127.0.0.1*)",
      "Bash(curl -sS http://localhost*)",
      "Bash(curl -i http://127.0.0.1*)",
      "Bash(curl -i http://localhost*)"
    ],
    "ask": ["Edit(./.claude/**)", "Write(./.claude/**)"],
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push origin develop*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git checkout main*)",
      "Bash(git switch main*)",
      "Bash(cargo install*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/.ssh/**)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/credentials)",
      "Read(**/.aws/**)"
    ]
  }
}
